<!-- Memanggil partial header -->
<%- include('../partials/header', { pageTitle: pageTitle }) %>

<!-- Judul Halaman -->
<section class="page-heading">
  <span class="eyebrow">KELOLA KOLEKSI</span>

  <h1>Tambah Buku Baru</h1>

  <p>
    Lengkapi formulir berikut untuk
    menambahkan buku ke katalog.
  </p>
</section>

<!-- Form Tambah Buku -->
<section class="card form-card">

  <!-- Mengirim data menggunakan HTTP POST -->
  <form action="/katalog/tambah" method="POST">

    <!-- Input Teks -->
    <div class="form-group">
      <label for="judul">Judul Buku</label>

      <input
        type="text"
        id="judul"
        name="judul"
        placeholder="Masukkan judul buku"
        required
      >
    </div>

    <!-- Input Angka -->
    <div class="form-group">
      <label for="halaman">Jumlah Halaman</label>

      <input
        type="number"
        id="halaman"
        name="halaman"
        min="1"
        placeholder="Contoh: 250"
        required
      >
    </div>

    <!-- Input Dropdown -->
    <div class="form-group">
      <label for="kategori">Kategori Buku</label>

      <select
        id="kategori"
        name="kategori"
        required
      >
        <option value="">-- Pilih Kategori --</option>
        <option value="Teknologi">Teknologi</option>
        <option value="Novel">Novel</option>
        <option value="Pengembangan Diri">
          Pengembangan Diri
        </option>
        <option value="Pendidikan">Pendidikan</option>
        <option value="Sejarah">Sejarah</option>
      </select>
    </div>

    <!-- Tombol Submit -->
    <button type="submit" class="button">
      Simpan Buku
    </button>

    <a href="/katalog" class="button-secondary">
      Batal
    </a>

  </form>

</section>

<!-- Memanggil partial footer -->
<%- include('../partials/footer') %>